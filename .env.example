# Database (Prisma / SQLite — default local mode)
DATABASE_URL=file:./db/custom.db

# Optional: Supabase (for production cross-device persistence)
# If both are set, the storage layer routes to Supabase; otherwise falls back to Prisma/SQLite.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
