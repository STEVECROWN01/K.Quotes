# ====== Supabase (REQUIRED — persistence is Supabase-only) ======
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy these values from Project Settings → API

# Public URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only — bypasses RLS)
# ⚠️ NEVER prefix with NEXT_PUBLIC_ and never commit this file with real values
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key (browser-side — respects RLS policies)
# Optional if you only use server-side access via the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====== Resend (OPTIONAL — self-BCC email on PDF generation) ======
# Get a free API key at https://resend.com (100 emails/day free tier).
# 1. Verify your sending domain (or use onboarding@resend.dev for testing)
# 2. Create an API key at https://resend.com/api-keys
# 3. Set these 3 vars — leave all 3 blank to disable email entirely
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=Keter Quotes <quotes@yourdomain.com>
SELF_BCC_EMAIL=you@example.com
