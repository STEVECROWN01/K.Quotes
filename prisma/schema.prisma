// Keter Marketing — Quote & Invoice Generator
// Prisma schema. Used locally (SQLite) when Supabase env vars are absent.
// The storage layer (`src/lib/storage.ts`) routes to Supabase if configured,
// otherwise falls back to Prisma/SQLite. The data shape is identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Quote {
  id            String   @id @default(cuid())
  quoteNumber   String   @unique // e.g. D2600004 — also doubles as invoice number with F prefix
  docType       String   // "devis" | "facture"
  language      String   // "fr" | "en"
  clientNumber  Int
  date          String   // ISO date (YYYY-MM-DD)
  fullName      String
  city          String?
  country       String?
  phone         String?
  email         String?
  service       String   // "cv" | "linkedin" | "both"
  priceCv       Float?
  priceLinkedin Float?
  // Bank / payment details (editable per quote — saved snapshot)
  accountHolder String
  iban          String
  bic           String
  bank          String
  paymentMode   String
  paymentConditions String
  paymentLink   String?
  // Invoice-only fields
  paymentStatus String?  // "Payé" | "Paid" | "En attente"
  paymentDate   String?  // ISO date
  status        String   @default("draft") // "draft" | "saved" | "invoiced"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientNumber])
  @@index([status])
}
